# 行情与日志都在独立的 data 分支，不进主仓
data/
logs/
state/
# 实盘账本（持仓/补选/幂等键）要进主仓，不能跟着旧的 state/ 一起被忽略
!live/state/
!live/state/**

# 回测产物一律不入库，只跟踪网页看板（单文件 HTML，离线可看）
reports/*
!reports/web/
reports/web/*
!reports/web/*.html

.venv/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.ruff_cache/
.mypy_cache/

# 密钥
.env
.env.*

# 本地推送脚本（含历史 token，不入库）
_push.ps1
